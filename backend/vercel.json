{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{frontend/**,node_modules/**,.venv/**,**/__pycache__/**,**/*.pyc}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.py" },
    { "source": "/upload", "destination": "/api/index.py" },
    { "source": "/summary", "destination": "/api/index.py" },
    { "source": "/ask", "destination": "/api/index.py" },
    { "source": "/repo-tree", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" }
  ]
}
